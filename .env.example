# Optional. Without this, Prompt Brawl runs in demo mode: fighter extraction
# runs locally and the response is a simulated stream, so the whole
# experience still works with zero setup.
ANTHROPIC_API_KEY=

# Optional. Model used for the main generated response.
# Defaults to claude-sonnet-5 if unset. Fighter extraction always uses a
# fast/cheap model (claude-haiku-4-5-20251001) regardless of this setting.
ANTHROPIC_MODEL=claude-sonnet-5
